// Maplecake database schema (PostgreSQL on Supabase).
//
// DATABASE_URL = Supabase pooled connection (port 6543, add ?pgbouncer=true) - used by the running app.
// DIRECT_URL   = Supabase direct connection (port 5432) - used only by `prisma migrate`.

generator client {
  provider   = "prisma-client-js"
  engineType = "client" // Rust-free client: runs through the `pg` driver adapter
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskType {
  TASK
  BUG
  FEATURE
}

enum ActivityAction {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  TASK_DELETED
  MEMBER_INVITED
  INVITE_DECLINED
  INVITE_CANCELLED
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_OVERDUE
  TASK_STATUS_CHANGED
  ADDED_TO_PROJECT
  ROLE_CHANGED
  REMOVED_FROM_PROJECT
  HEALTH_DROPPED
  INVITE_RECEIVED
  INVITE_ACCEPTED
  INVITE_DECLINED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  assignedTasks Task[]          @relation("TaskAssignee")
  createdTasks  Task[]          @relation("TaskCreator")
  activities    ActivityLog[]
  notifications Notification[]
  sentInvites     ProjectInvite[] @relation("InviteSender")
  receivedInvites ProjectInvite[] @relation("InviteReceiver")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  ownerId     String
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       ProjectMember[]
  tasks         Task[]
  activities    ActivityLog[]
  notifications Notification[]
  invites       ProjectInvite[]

  @@index([ownerId])
  @@index([status])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  type        TaskType     @default(TASK)
  dueDate     DateTime?
  assigneeId  String?
  creatorId   String
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([projectId, priority, type])
  @@index([assigneeId])
}

model ActivityLog {
  id        String         @id @default(cuid())
  projectId String
  actorId   String?
  taskId    String?
  action    ActivityAction
  message   String
  createdAt DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  projectId String?
  taskId    String?
  type      NotificationType
  message   String
  readAt    DateTime?
  dismissedAt DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}

model ProjectInvite {
  id          String       @id @default(cuid())
  projectId   String
  inviterId   String?
  inviteeId   String
  role        ProjectRole  @default(MEMBER)
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter User?   @relation("InviteSender", fields: [inviterId], references: [id], onDelete: SetNull)
  invitee User    @relation("InviteReceiver", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([projectId, inviteeId])
  @@index([inviteeId, status])
  @@index([projectId, status])
  @@index([createdAt])
}

/// A pending sign-up verification code. At most one row per email address.
/// The row is deleted the moment the code is used to create the account.
/// It stays after expiry (until cleaned up) so the resend cooldown and hourly limit keep working.
model EmailCode {
  id              String   @id @default(cuid())
  email           String   @unique
  codeHash        String
  attempts        Int      @default(0) // wrong guesses against the current code
  sendCount       Int      @default(1) // codes sent in the current one-hour window
  windowStartedAt DateTime @default(now())
  lastSentAt      DateTime @default(now())
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}
