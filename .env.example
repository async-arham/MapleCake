# Copy to .env.local (used by `next dev`) AND to .env (used by Prisma commands and the seed script).

# --- Database (Supabase) ---
# Transaction pooler, port 6543, with ?pgbouncer=true. Used by the running app.
DATABASE_URL="postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler or direct connection, port 5432. Used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres"

# --- App ---
# 32+ random characters: openssl rand -base64 32
AUTH_SECRET=""
APP_URL="http://localhost:3000"
# 16+ characters. Enables /api/cron/overdue (optional)
CRON_SECRET=""

# --- Email verification at sign-up ---
# "on" (default): new accounts must type a 6-digit code that was emailed to them.
# "off": the old sign-up without a code (handy for automated tests).
EMAIL_VERIFICATION="on"

# SMTP server that sends the code. Leave these empty while developing: the code is then printed in the
# terminal running `npm run dev` instead of being emailed. In production they are required.
#
# Gmail (quickest way to start):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password below (NOT your normal Gmail password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS=""
# Shown as the sender. Optional; defaults to "Maplecake <SMTP_USER>".
EMAIL_FROM="Maplecake <you@gmail.com>"
