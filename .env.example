# Copy this file to .env.local (for `next dev`) and also to .env (for Prisma CLI commands).
# Never commit real values. All of these are read on the server only.

# --- Supabase Postgres (Project Settings > Database > Connection string) ---
# Pooled connection (Transaction pooler, port 6543). Used by the running app.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432). Used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# --- Authentication ---
# Random string, at least 32 characters. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# --- App ---
APP_URL="http://localhost:3000"

# Optional: protects /api/cron/overdue (Vercel Cron sends it automatically). 16+ characters.
CRON_SECRET=""
